# Copy this file, then fill only what you need:
#   cp .env.example .env
# Restart Metro after changing .env. Never commit .env.
#
# Sandbox IAP (development / preview APK, not Expo Go): paste the RevenueCat
# Test Store *public* SDK key into EXPO_PUBLIC_REVENUECAT_API_KEY.

# Test Store public SDK key for sandbox. Never the secret REST key.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Optional. Analyze still works if empty. Publishable / anon key only. Never service_role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# MUST stay empty. Never bundle a real Claude key (EXPO_PUBLIC_* is compiled into the client).
EXPO_PUBLIC_CLAUDE_API_KEY=

# Optional. Local catalog / REST scripts only. Never EXPO_PUBLIC_. Never commit a real value.
REVENUECAT_SECRET=

# Public API base URL for native/APK builds (no trailing slash). URL only — never a key.
# Local web/dev can leave this empty to use relative /api/evaluate.
EXPO_PUBLIC_API_URL=

# Server-only (app/api/evaluate+api.ts). Never EXPO_PUBLIC_. Never commit a real value.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.5 in the API route if empty.
OPENAI_MODEL=
