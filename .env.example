# A real Claude key must NEVER go in EXPO_PUBLIC_* (it is bundled into the client).
# The current app does not call Claude: evaluateOpportunity() is an on-device mock
# until a server-side key exists. Leave this empty.
EXPO_PUBLIC_CLAUDE_API_KEY=
# Public SDK key only (Test Store key for sandbox, Apple/Google keys later). Never the secret REST API key.
# Unused in Expo Go. Required in a development / store build for Subscribe.
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Optional. Analyze still works if these are empty. Publishable / anon key only. Never service_role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional. v2 secret REST key for local catalog scripts only. Never EXPO_PUBLIC_. Never commit a real value.
REVENUECAT_SECRET=
