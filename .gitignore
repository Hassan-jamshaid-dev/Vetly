# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
build/
web-build/
expo-env.d.ts

# Native (Expo managed; generate locally with expo run / EAS)
android/
ios/
.kotlin/
*.orig.*

# Signing, keys, store credentials
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.pem
*.mobileprovision
credentials.json
service-account.json
google-services.json
GoogleService-Info.plist

# Store / installer packages (never commit binaries)
*.apk
*.aab
*.ipa
*.dSYM.zip
*.app.dSYM.zip

# Metro
.metro-health-check*

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.log

# OS junk
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors / IDEs
.idea/
.vs/
*.suo
*.user
*.swp
*.swo
*~
*.bak

# local env files (never commit secrets)
.env
.env.*
!.env.example

# scratch scripts (never commit). Product shots in assets/screenshots/ ARE committed.
.tmp*

# typescript
*.tsbuildinfo

# test / coverage
coverage/
.nyc_output/

# Local Netlify folder
.netlify

# Supabase CLI scratch
supabase/.temp/

# Local Expo agent skills (do not push — they double the tree)
.agents/
skills-lock.json
